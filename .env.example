# Copy to .env, which git ignores. Never put real keys in this example file.

# Posting-text calls. Use Groq's free plan: its calls count as $0, so paid-plan spend would skip the cap.
# Without this key, postings show as model unavailable and keep their pasted title.
GROQ_API_KEY=

# Paid calls for personal-data steps, from a Console API key.
# Set a spend limit in the Console too, as a backstop to the app's own cap.
ANTHROPIC_API_KEY=

# Optional tracing. Choose your data region deliberately, because there is no default:
# https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US) or https://jp.cloud.langfuse.com (Japan)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
